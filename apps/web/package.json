{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && size-limit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@helpdesk/contracts": "workspace:*",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-table": "9.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "react-router": "8.4.0",
    "recharts": "3.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@size-limit/file": "14.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "size-limit": "14.2.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4"
  },
  "size-limit": [
    {
      "path": "dist/assets/*.js",
      "limit": "499 KB",
      "gzip": true,
      "brotli": false
    }
  ]
}
