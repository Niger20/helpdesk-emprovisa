{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "db:migrate": "tsx src/infra/db/migrate.ts",
    "db:codegen": "tsx src/infra/db/codegen.ts",
    "db:seed": "tsx src/infra/db/seeds/run.ts",
    "build": "tsc -p tsconfig.build.json && node src/infra/db/copy-migrations.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.1.2",
    "@fastify/multipart": "10.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@helpdesk/contracts": "workspace:*",
    "argon2": "0.45.1",
    "fastify": "5.12.5",
    "fastify-plugin": "6.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "file-type": "22.1.1",
    "kysely": "0.29.6",
    "kysely-codegen": "0.20.0",
    "luxon": "3.7.2",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "3.7.6",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15"
  }
}
